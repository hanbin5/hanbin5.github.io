---
import JournalLayout from "../layouts/JournalLayout.astro";

/**
 * Calendar — embeds the author's Google Calendar as-is (Google's own
 * UI, not a re-implementation). All source calendars are merged into
 * one view and shown as plain "Busy" blocks; the underlying calendars
 * must be shared as "See only free/busy (hide details)" in Google
 * Calendar's own sharing settings for that to hold — this page has no
 * control over what Google serves, it only assembles the embed URL.
 */
const CALENDAR_IDS = [
  "hanbinftr55@gmail.com",
  // Canvas (LMS import calendar) intentionally excluded — it's a
  // subscribed, not owned, calendar, so its sharing/free-busy setting
  // can't be changed here and it would leak assignment titles.
  "c86a6a8b7a46e3174a955a50c8ba05ec26ec10185f62e15e53ed443c3b564abb@group.calendar.google.com", // CCC
  "8e2948ab368f4fc60927999501abc9005ec03550c0d5c269a9c1394b0d576b84@group.calendar.google.com", // Graduation
  "6693fcf66ff8ddd373b0723cb01a24a53ce7f208c76e6ad51b1734bc49c5bec0@group.calendar.google.com", // 알바
  "d929d9115e0f0776fa3258bdc46892f1b17b8fd9ad2ed20859e409aef0dd3a52@group.calendar.google.com", // Coursework
  "456b0854d1a9cde1a1404120126de1978b21c6f4f07b578b51dd4af84a0099e4@group.calendar.google.com", // Soul
  "a83e413738104699b24c7fdc05a0cc7d75c3d6556c8f5832337e9e6b059ecacb@group.calendar.google.com", // Church
  "ko.south_korea#holiday@group.v.calendar.google.com", // 대한민국의 휴일
];

const params = new URLSearchParams();
CALENDAR_IDS.forEach((id) => params.append("src", id));
params.set("ctz", "Asia/Seoul");
params.set("mode", "WEEK");
params.set("wkst", "2"); // week starts Monday
params.set("showTitle", "0");
params.set("showCalendars", "0"); // hides the per-calendar name list (Church, 알바, ...)
params.set("showTz", "0");
params.set("showPrint", "0");
params.set("showTabs", "1");
params.set("bgcolor", "%23ffffff");

const embedSrc = `https://calendar.google.com/calendar/embed?${params.toString()}`;
---
<JournalLayout
  title="Calendar — HANBIN"
  description="한빈(Hanbin) · 일정 (Free/Busy)"
>
  <section class="calendar-page">
    <div class="container">
      <div class="calendar-head">
        <div class="kicker">§ Schedule</div>
        <h1>Calendar</h1>
        <p class="lede">
          모든 개인 캘린더를 하나로 합쳐 보여줍니다. 일정 제목이나 내용은
          공개되지 않고, 비어있는 시간과 <strong>바쁨(Busy)</strong> 블록만
          표시됩니다.
        </p>
      </div>

      <div class="calendar-embed">
        <iframe
          src={embedSrc}
          style="border:0"
          width="100%"
          height="700"
          frameborder="0"
          scrolling="no"
          title="Hanbin's Calendar"
        ></iframe>
      </div>
    </div>
  </section>
</JournalLayout>

<style>
  .calendar-page {
    padding: 56px 0 96px;
  }

  .calendar-head {
    max-width: 960px;
    margin: 0 auto 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .calendar-head .kicker {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-bright);
    margin-bottom: 14px;
  }
  .calendar-head h1 {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 18px;
  }
  .calendar-head .lede {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.6;
    color: var(--muted);
    max-width: 62ch;
  }
  .calendar-head .lede strong {
    color: var(--ink);
    font-weight: 600;
  }

  .calendar-embed {
    border: 1px solid var(--line-soft);
    overflow: hidden;
    background: var(--paper);
  }
  .calendar-embed iframe {
    display: block;
    min-height: 500px;
  }

  @media (max-width: 640px) {
    .calendar-embed iframe {
      height: 560px;
    }
  }
</style>
