---
import JournalLayout from "../layouts/JournalLayout.astro";
import CalendarEmbed from "../components/CalendarEmbed.astro";
---
<JournalLayout
  title="Calendar — HANBIN"
  description="Hanbin Oh · Schedule (Free/Busy)"
>
  <section class="calendar-page">
    <div class="container">
      <div class="calendar-head">
        <div class="kicker">§ Schedule</div>
        <h1>Calendar</h1>
        <p class="lede">
          All personal calendars merged into a single view. Event titles and
          details stay private — only free time and <strong>Busy</strong>
          blocks are shown.
        </p>
      </div>

      <CalendarEmbed />
    </div>
  </section>
</JournalLayout>

<style>
  .calendar-page {
    padding: 56px 0 96px;
  }

  .calendar-head {
    max-width: 960px;
    margin: 0 auto 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .calendar-head .kicker {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-bright);
    margin-bottom: 14px;
  }
  .calendar-head h1 {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(40px, 5vw, 64px);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 18px;
  }
  .calendar-head .lede {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.6;
    color: var(--muted);
    max-width: 62ch;
  }
  .calendar-head .lede strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
